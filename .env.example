# Copy to .env.local for local overrides, or .env.production before running
# `npm run build` for a production/cPanel deploy. Next.js only inlines
# NEXT_PUBLIC_* vars at BUILD time — changing this after building does
# nothing until you rebuild.

# Local dev: leave this empty/unset. next.config.js proxies relative
# "/api/..." calls to the backend (see server/.env's PORT) so nothing else
# is needed.
#
# Production (static export): set this to the deployed backend's public
# HTTPS URL, e.g. https://api.yourdomain.com — see server/DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=
