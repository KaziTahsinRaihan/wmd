# Copy to .env and fill in your own values.

PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Set this to the API's own public HTTPS URL in production (e.g.
# https://api.yourdomain.com) — leave empty for local dev. It's baked into
# file URLs stored in question payloads / avatars so <img>/<audio> tags work
# when the frontend is a static export on a different origin. See
# DEPLOYMENT.md.
PUBLIC_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ielts_prep

# Bearer session tokens (opaque, hashed in the auth_tokens table).
TOKEN_TTL_DAYS=30

# Seeded once on first boot, only if no admin account exists yet.
# Change the password immediately from the admin dashboard after first login.
ADMIN_NAME=Admin Office
ADMIN_EMAIL=admin@demo.io
ADMIN_PASSWORD=1234

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30
